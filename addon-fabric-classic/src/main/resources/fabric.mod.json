  "icon": "assets/e4steam_public_servers/icon.png",
  "description": "A privacy-safe catalog of public e4steam worlds and dedicated servers.",
  "authors": ["Kamilchik", "K2 Studio"],
  "contact": {
    "sources": "https://github.com/K2-Studio-Development/e4steam-Public-Servers",
