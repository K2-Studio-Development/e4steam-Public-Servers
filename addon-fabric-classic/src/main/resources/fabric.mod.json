    "e4steam": ["dev.k2studio.e4steam.publicservers.common.PublicServersAddon"]
  },
  "mixins": [{"config": "e4steam_public_servers.portable.mixins.json", "environment": "client"}],
  "depends": {
    "fabricloader": ">=0.14.0",
    "minecraft": ">=1.19 <26.1-",
